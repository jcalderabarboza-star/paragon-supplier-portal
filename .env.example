#  ─────────────────────────────────────────────────────────────────────────────
#  EVERY ENVIRONMENT VARIABLE THIS TREE READS.
#
#  Not a suggestion and not a starting point: `src/lib/envGate/` derives the
#  read set from source on every test run (`import.meta.env.X`, `process.env.X`)
#  and FAILS if the code reads a name this file does not list, or if this file
#  lists a name nothing reads. Both directions, so the list can neither go stale
#  nor grow decorative entries.
#
#  NOTHING HERE IS REQUIRED TO RUN THE APP. `npm run dev`, `npm run build`,
#  `npm run preview` and `npm run gates` all work with no .env file at all —
#  every variable below is either optional with a stated default, set for you by
#  a platform, or provided by the tooling.
#
#  To use it:  cp .env.example .env.local     (.env and .env.local are ignored)
#  ─────────────────────────────────────────────────────────────────────────────


#  ── 1 · CLIENT, OPT-IN · the dev-only chaos mock ─────────────────────────────
#
#  A fault injector wrapped around the in-memory data service so loading,
#  retry and error states can be seen without a backend. It is DOUBLY gated:
#  `import.meta.env.DEV && VITE_CHAOS === 'on'` (src/main.tsx), so it is
#  statically false in a production build and tree-shaken out of the bundle.
#  These are `VITE_`-prefixed, which means Vite INLINES them into client code —
#  never put a secret behind that prefix.

# Set to exactly "on" to wrap the data service. Any other value, or unset, is off.
# default: unset (off)
VITE_CHAOS=

# Artificial latency floor, in milliseconds.
# default: 200
VITE_CHAOS_MIN_MS=

# Artificial latency ceiling, in milliseconds.
# default: 900
VITE_CHAOS_MAX_MS=

# Fraction of calls that fail, 0–1.
# default: 0.15
VITE_CHAOS_FAILURE_RATE=


#  ── 2 · BUILD-TIME · the deploy-environment badge ────────────────────────────

# Set by Vercel at build time ('production' | 'preview' | 'development'). Read in
# vite.config.ts and injected into the client as the `__DEPLOY_ENV__` define — it
# is the deploy-path-independent signal the env badge keys off (ENV-BADGE-01).
# Off Vercel it is absent, the define is '', and the badge falls back to a
# hostname allowlist. Setting it by hand locally only forces the badge.
# default: unset (empty define; hostname fallback)
VERCEL_ENV=


#  ── 3 · SERVER-SIDE · the access gate (SEC-GATE-01) ──────────────────────────
#
#  These are deliberately NOT `VITE_`-prefixed, so they are never bundled. They
#  are read at the edge in `middleware.js` and by the local verify harness in
#  `scripts/gate-preview-server.mjs`, both through the same `gate/` core.
#
#  ⚠️ THE GATE FAILS CLOSED. If any of the three is unset the gate serves a 503
#  rather than the app — which is why they are only needed for the deployed site
#  and for `scripts/gate-preview-server.mjs`. `npm run preview` does not use them.

# Username the edge gate accepts.
# default: unset (gate serves 503)
GATE_USER=

# Password the edge gate accepts.
# default: unset (gate serves 503)
GATE_PASSWORD=

# HMAC-SHA256 key that signs the 7-day HttpOnly session cookie. Any long random
# string; rotating it invalidates every issued session.
# default: unset (gate serves 503)
GATE_SECRET=

# Port for the local gate verify harness only (scripts/gate-preview-server.mjs).
# The Vite dev server and `vite preview` do not read it.
# default: 4178
PORT=


#  ── 4 · SET BY THE TOOLING · listed because the code reads them ──────────────
#
#  Nothing below is yours to set in this file. They are here because the guard
#  derives its list from what the source READS, and an unexplained name in that
#  list is worse than a documented one.

# Set to "true" by GitHub Actions. `scripts/gates.mjs` reads it only to switch
# its console output to ::group:: folding. Absent locally.
# default: unset (plain console output)
# GITHUB_ACTIONS=

# Vite built-in, not settable here: true under `vite dev`, false in a build.
# default: derived from the vite command
# DEV=

# Vite built-in, not settable here: 'development' | 'production' | 'test'. The
# query client disables retries when it is 'test'.
# default: derived from the vite command
# MODE=
